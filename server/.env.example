# beyondLDA2 API Server — local development config
# Copy to .env and adjust as needed

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mydb
DB_USER=myuser
DB_PASSWORD=mypassword

# Redis (defaults are fine for local dev)
REDIS_HOST=localhost
REDIS_PORT=6379

# Server
API_HOST=0.0.0.0
API_PORT=8000

# Worker
WORK_DIR=/tmp/beyondlda2-jobs
MPI_NPROCS=4
GPAW_SETUP_PATH=/home/clackyuser/.local/lib/python3.12/site-packages/gpaw_data/setups

# ASE DB
ASE_DB_DIR=/home/clackyuser/scratch/beyondLDA2/ase-dbs
