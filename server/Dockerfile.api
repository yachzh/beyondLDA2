# syntax = docker/dockerfile:1
# Lightweight API-only image — no GPAW, no MPI, no build tools.
# Intended for the cloud server that only serves REST endpoints.

FROM python:3.12-slim-bookworm

WORKDIR /app

# Install API server dependencies only
COPY server/requirements.api.txt .
RUN pip install --no-cache-dir -r requirements.api.txt

# Copy beyondLDA2 source (runner + schemas needed for script generation)
COPY beyondLDA2.py beyondLDA2_db.py ./
COPY server/ ./server/

# Default: run FastAPI/uvicorn (override in docker-compose for worker)
CMD ["uvicorn", "server.api:app", "--host", "0.0.0.0", "--port", "8000"]
